#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define NAV 1
#define NUM 2
#define MKR 3
#define MOD 4

#define KEYS_L   0  1  2  3  4  5  6 \
                14 15 16 17 18 19 20 \
                28 29 30 31 32 33 34 \
                46 47 48 49 50 51    \
                60 61 62 63 64

#define THUMBS_LEFT     35 36 \
                           52 \
                     65 66 67 \

#define KEYS_R   7  8  9 10 11 12 13 \
                21 22 23 24 25 26 27 \
                39 40 41 42 43 44 45 \
                   54 55 56 57 58 59 \
                      71 72 73 74 75

#define THUMBS_RIGHT 37 38    \
                     53       \
                     68 69 70 \

/ {

  combos {
    compatible = "zmk,combos";

    // copy {
    //   key-positions = <48 49>;
    //   bindings = <&macro_copy>;
    // };

  };

  behaviors {
    #include "macros.dtsi"
    #include "version.dtsi"

    macros {
      macro_copy: shift_tab {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LSHIFT>, <&macro_tap &kp TAB>, <&macro_release &kp LSHIFT>;
      };

      macro_copy: ctrl_g {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp G>, <&macro_release &kp LCTRL>;
      };
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";                                                                                                                     // WARN: do not remove this MOD
      bindings = <                                                                                                                               //  |||
        &none   &none   &none   &none     &none     &none     &none                                                                              &mo MOD &none     &none     &none       &none      &none       &none
        &none   &kp Q   &kp W   &kp E     &kp R     &kp T     &none                                                                              &none   &kp Y     &kp U     &kp I       &kp O      &kp P       &none
        &none   &kp A   &kp S   &kp D     &kp F     &kp G     &none                   &kp LCMD    &kp LALT   &kp RALT   &kp RCMD                 &none   &kp H     &kp J     &kp K       &kp L      &kp SEMI    &none
        &none   &kp Z   &kp X   &kp C     &kp V     &kp B                                         &kp HOME   &kp PG_UP                                   &kp N     &kp M     &kp COMMA   &kp DOT    &kp FSLH    &none
        &none   &none   &none   &none     &none                        &mo NAV       &LSHIFT      &kp END    &kp PG_DN   &kp SPACE   &mo SYM                       &none     &none       &none      &mo FN      &none
      >;
    };

    nav {
      display-name = "Nav";
      bindings = <
        &trans   &trans     &trans    &trans    &trans    &trans   &none                                                                   &none  &trans       &trans     &trans     &trans     &trans     &trans
        &trans   &shift_tab &trans    &trans    &trans    &trans   &none                                                                   &none  &caps_word   &kp PG_DN  &kp PG_UP  &kp TAB    &kp BSPC   &trans
        &trans   &kp ESC    &trans    &trans    &trans    &ctrl_g  &none                       &trans &trans   &trans   &trans             &none  &kp LEFT     &kp DOWN   &kp UP     &kp RIGHT  &kp ENTER  &trans
        &trans   &kp LSHFT  &sk LCTRL &trans    &trans    &trans                                      &trans   &trans                             &trans       &kp END    &kp HOME   &sk LTRL   &kp LSHIFT &trans
        &trans   &trans     &trans    &trans    &trans                                  &trans &trans &trans   &trans   &trans   &mo MKR                       &trans     &trans     &trans     &trans     &trans
      >;
    };

    num {
      display-name = "Num";
      bindings = <
        &trans   &trans    &trans    &trans    &trans    &trans    &none                                                                   &none  &trans     &trans     &trans     &trans    &trans     &trans
        &trans   &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT &none                                                                   &none  &kp CARET  &kp AMPS   &kp STAR   &kp LPAR  &kp RPAR   &trans
        &trans   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &none                       &trans &trans   &trans   &trans             &none  &kp N6     &kp N7     &kp N8     &kp N9    &kp N0     &trans
        &trans   &trans    &kp ???L  &kp ???   &kp ???H  &trans                                       &trans   &trans                             &trans     &kp ???    &kp ???    &kp LBKT  &kp RBKT   &trans
        &trans   &trans    &trans    &trans    &trans                                   &trans &trans &trans   &trans   &trans   &trans                      &trans     &trans     &trans    &trans     &trans
      >;
    };

    mkr {
      display-name = "Mkr";
      bindings = <
        &trans   &trans   &trans    &trans    &trans    &trans  &none                                                                   &none  &trans    &trans     &trans     &trans    &trans     &trans
        &trans   &trans   &kp AMPS  &kp STAR  &kp LPAR  &trans  &none                                                                   &none  &trans    &kp LBKT   &kp RBKT   &kp LBRC  &kp RBRC   &trans
        &trans   &kp N1   &kp N2    &kp N3    &kp N4    &kp N5  &none                       &trans &trans   &trans   &trans             &none  &kp N6    &kp N7     &kp N8     &kp N9    &kp N0     &trans
        &trans   &trans   &kp EXCL  &kp AT    &kp HASH  &trans                                     &trans   &trans                             &trans    &kp DQT    &kp SQT    &kp GRAVE &kp PIPE   &trans
        &trans   &trans   &trans    &trans    &trans                                 &trans &trans &trans   &trans   &trans   &trans                     &trans     &trans     &trans    &trans     &trans
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock     &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                  &stp STP_BAT  &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };


    extra1 { 
      display-name = "Red";
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";
      status = "reserved";
    };
  };
};

/* vim: set ft=c nowrap: */
