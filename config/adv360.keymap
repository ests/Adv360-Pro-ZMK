#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAUKT 0
#define NAV 1
#define NUM 2
#define MKR 3
#define MOD 4
#define FN 5

#define KEYS_L   0  1  2  3  4  5  6 \
                14 15 16 17 18 19 20 \
                28 29 30 31 32 33 34 \
                46 47 48 49 50 51    \
                60 61 62 63 64

#define THUMBS_LEFT     35 36 \
                           52 \
                     65 66 67 \

#define KEYS_R   7  8  9 10 11 12 13 \
                21 22 23 24 25 26 27 \
                39 40 41 42 43 44 45 \
                   54 55 56 57 58 59 \
                      71 72 73 74 75

#define THUMBS_RIGHT 37 38    \
                     53       \
                     68 69 70 \

/ {

  combos {
    compatible = "zmk,combos";

    combo_under {
      key-positions = <29 33>;
      bindings = <&kp UNDER>;
    };

    combo_minus {
      key-positions = <40 44>;
      bindings = <&kp MINUS>;
    };

    combo_pipe {
      key-positions = <47 51>;
      bindings = <&kp PIPE>;
    };

    combo_lbrc {
      key-positions = <15 19>;
      bindings = <&kp LBRC>;
    };

    combo_rbrc {
      key-positions = <22 26>;
      bindings = <&kp RBRC>;
    };

    combo_alpha {
      key-positions = <41 42 43>;
      bindings = <&kp LCMD>;
    };

    combo_bravo {
      key-positions = <16 17 32>;
      bindings = <&kp LALT>;
    };

    combo_charlie {
      key-positions = <16 17 32>;
      bindings = <&kp LALT>;
    };

    combo_delta {
      key-positions = <43 44>;
      bindings = <&kp SQT>;
    };

    combo_echo {
      key-positions = <41 24 25>;
      bindings = <&kp LALT>;
    };

    combo_foxtrot {
      key-positions = <66 69>;
      bindings = <&kp LCTRL>;
    };

    combo_golf {
      key-positions = <66 69>;
      bindings = <&kp LCTRL>;
    };

    combo_hotel {
      key-positions = <48 49 50>;
      bindings = <&kp LCTRL>;
    };
  
    combo_india {
      key-positions = <49 50 55 56>;
      bindings = <&kp ESC>;
    };
  
    combo_juliet {
      key-positions = <33 40>;
      bindings = <&sk LCTRL &sk LSHIFT &sk LALT &sk LGUI>;
    };
 
    combo_kilo {
      key-positions = <30 31 32>;
      bindings = <&kp LCTRL>;
    };
  };

  behaviors {
    #include "macros.dtsi"
    #include "version.dtsi"

    macros {
      ctrl_g: ctrl_g {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp G>, <&macro_release &kp LCTRL>;
      };

      shift_tab: shift_tab {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LSHIFT>, <&macro_tap &kp TAB>, <&macro_release &kp LSHIFT>;
      };

      m3: m3 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp MINUS>, <&macro_release &kp LCMD>;
      };

      m4: m4 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp N0>, <&macro_release &kp LCMD>;
      };

      m2: m2 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp EQUAL>, <&macro_release &kp LCMD>;
      };

      m10: m10 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD &kp LSHIFT>, <&macro_tap &kp N4>, <&macro_release &kp LCMD &kp LSHIFT>;
      };

      m5: m5 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp TAB>, <&macro_release &kp LCMD>;
      };

      m6: m6 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp SPACE>, <&macro_release &kp LCMD>;
      };

      m0: m0 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp C>, <&macro_release &kp LCMD>;
      };

      m1: m1 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp V>, <&macro_release &kp LCMD>;
      };

      m7: m7 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LALT &kp LCMD &kp LSHIFT>, <&macro_tap &kp UP>, <&macro_release &kp LALT &kp LCMD &kp LSHIFT>;
      };
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";                                                                                                                     // WARN: do not remove this MOD
      bindings = <                                                                                                                               //  |||
        &none   &none   &none   &none     &none     &none     &tog MOD                                                                           &mo MOD &none     &none     &none       &none      &none       &none
        &none   &kp Q   &kp W   &kp E     &kp R     &kp T     &none                                                                              &none   &kp Y     &kp U     &kp I       &kp O      &kp P       &none
        &kp ESC &kp A   &kp S   &kp D     &kp F     &kp G     &none                   &kp LCMD    &kp LALT   &kp RALT   &kp RCMD                 &none   &kp H     &kp J     &kp K       &kp L      &kp SEMI    &none
        &none   &kp Z   &kp X   &kp C     &kp V     &kp B                                         &kp HOME   &kp PG_UP                                   &kp N     &kp M     &kp COMMA   &kp DOT    &kp FSLH    &none
        &none   &none   &none   &none     &none                     &mo NAV       &kp LSHIFT      &kp END    &kp PG_DN   &kp SPACE   &mo NUM                       &none     &none       &none      &mo FN      &none
      >;
    };

    nav {
      display-name = "Nav";
      bindings = <
        &trans   &trans     &trans    &trans    &trans    &trans   &none                                                                   &none  &trans       &trans     &trans     &trans     &trans     &trans
        &trans   &shift_tab &trans    &trans    &trans    &trans   &none                                                                   &none  &caps_word   &kp PG_DN  &kp PG_UP  &kp TAB    &kp BSPC   &trans
        &trans   &kp ESC    &trans    &trans    &trans    &ctrl_g  &none                       &trans &trans   &trans   &trans             &none  &kp LEFT     &kp DOWN   &kp UP     &kp RIGHT  &kp ENTER  &trans
        &trans   &kp LSHFT  &sk LCTRL &trans    &trans    &trans                                      &trans   &trans                             &trans       &kp END    &kp HOME   &sk LCTRL  &kp LSHIFT &trans
        &trans   &trans     &trans    &trans    &trans                                  &trans &trans &trans   &trans   &trans   &mo MKR                       &trans     &trans     &trans     &trans     &trans
      >;
    };

    num {
      display-name = "Num";
      bindings = <
        &trans   &trans    &trans    &trans    &trans    &trans    &none                                                                    &none  &trans     &trans     &trans     &trans    &trans     &trans
        &trans   &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT &none                                                                    &none  &kp CARET  &kp AMPS   &kp STAR   &kp LPAR  &kp RPAR   &trans
        &trans   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &none                        &trans &trans   &trans   &trans             &none  &kp N6     &kp N7     &kp N8     &kp N9    &kp N0     &trans
        &trans   &kp PLUS  &kp MINUS &kp EQUAL &kp UNDER &kp PIPE                                      &trans   &trans                             &trans     &kp GRAVE  &kp NUBS   &kp LBKT  &kp RBKT   &trans
        &trans   &trans    &trans    &trans    &trans                                   &mo MKR &trans &trans   &trans   &trans   &trans                      &trans     &trans     &trans    &trans     &trans
      >;
    };

    mkr {
      display-name = "Mkr";
      bindings = <
        &none   &none   &none    &none   &none    &none   &none                                                                   &none  &none     &none       &none         &none         &none  &none
        &none   &none   &m3      &m4     &m2      &none   &none                                                                   &none  &none     &kp C_MUTE  &kp C_VOL_UP  &kp C_VOL_DN  &none  &none
        &none   &none   &none    &m10    &m5      &none   &none                       &none &none   &none   &none                 &none  &none     &m6         &kp C_BRI_UP  &kp C_BRI_DN  &none  &none
        &none   &none   &none    &m0     &m1      &m7                                        &none   &none                               &none     &kp C_PP    &kp C_PREV    &kp C_NEXT    &none  &none
        &none   &none   &none    &none   &none                                  &none &none &none   &none   &none   &none                          &none       &none         &none         &none  &none
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };

    extra1 { 
      display-name = "Red";
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";
      status = "reserved";
    };
  };
};

/* vim: set ft=c nowrap: */
