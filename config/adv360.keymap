#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NAV 1
#define NUM 2
#define MKR 3
#define MOD 4

// Key position defines for 34-key layout on Kinesis 360
#define KEYS_L   0  1  2  3  4  5  6 \
                14 15 16 17 18 19 20 \
                28 29 30 31 32 33 34 \
                46 47 48 49 50 51    \
                60 61 62 63 64

#define THUMBS_LEFT     35 36 \
                           52 \
                     65 66 67 \

#define KEYS_R   7  8  9 10 11 12 13 \
                21 22 23 24 25 26 27 \
                39 40 41 42 43 44 45 \
                   54 55 56 57 58 59 \
                      71 72 73 74 75

#define THUMBS_RIGHT 37 38    \
                     53       \
                     68 69 70 \

/ {

  combos {
    compatible = "zmk,combos";

    // A+G -> _ (underscore)
    combo_underscore {
      key-positions = <29 33>;
      bindings = <&kp UNDER>;
    };

    // ;+H -> - (minus)
    combo_minus {
      key-positions = <44 40>;
      bindings = <&kp MINUS>;
    };

    // Z+B -> | (pipe)
    combo_pipe_left {
      key-positions = <47 51>;
      bindings = <&kp PIPE>;
    };

    // Q+T -> = (equals)
    combo_equals {
      key-positions = <15 19>;
      bindings = <&kp EQUAL>;
    };

    // Y+P -> ` (grave)
    combo_grave {
      key-positions = <22 26>;
      bindings = <&kp GRAVE>;
    };

    // J+K+L -> CMD
    combo_cmd_right {
      key-positions = <41 42 43>;
      bindings = <&kp LCMD>;
    };

    // W+E+F -> ALT
    combo_alt_left {
      key-positions = <16 17 32>;
      bindings = <&kp LALT>;
    };

    // I+O+J -> ALT
    combo_alt_right {
      key-positions = <24 25 41>;
      bindings = <&kp LALT>;
    };

    // L+; -> ' (quote)
    combo_quote {
      key-positions = <43 44>;
      bindings = <&kp SQT>;
    };

    // LSHIFT+SPACE -> CTRL
    combo_ctrl_thumbs {
      key-positions = <67 69>;
      bindings = <&kp LCTRL>;
    };

    // X+C+V -> CTRL
    combo_ctrl_left {
      key-positions = <48 49 50>;
      bindings = <&kp LCTRL>;
    };

    // C+V+M+, -> ESC
    combo_escape {
      key-positions = <49 50 56 57>;
      bindings = <&kp ESC>;
    };

    // M+,+. -> CTRL
    combo_ctrl_right {
      key-positions = <56 57 58>;
      bindings = <&kp LCTRL>;
    };

    // G+H -> OSM(HYPR)
    combo_hyper {
      key-positions = <33 40>;
      bindings = <&sk LS(LC(LA(LGUI)))>;
    };

    // S+D+F -> CMD
    combo_cmd_left {
      key-positions = <30 31 32>;
      bindings = <&kp LCMD>;
    };

    // /+N -> | (pipe)
    combo_pipe_right {
      key-positions = <59 55>;
      bindings = <&kp PIPE>;
    };
  };

  behaviors {
    #include "macros.dtsi"
    #include "version.dtsi"

    macros {
      // M0: Cmd+C (copy)
      m0: m0 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp C>, <&macro_release &kp LCMD>;
        display-name = "Copy";
      };

      // M1: Cmd+V (paste)
      m1: m1 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp V>, <&macro_release &kp LCMD>;
        display-name = "Paste";
      };

      // M2: Cmd+= (zoom in)
      m2: m2 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp EQUAL>, <&macro_release &kp LCMD>;
        display-name = "Zoom In";
      };

      // M3: Cmd+- (zoom out)
      m3: m3 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp MINUS>, <&macro_release &kp LCMD>;
        display-name = "Zoom Out";
      };

      // M4: Cmd+0 (reset zoom)
      m4: m4 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp N0>, <&macro_release &kp LCMD>;
        display-name = "Reset Zoom";
      };

      // M5: Cmd+Tab (app switcher with delay)
      m5: m5 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_pause_for_release>, <&macro_tap &kp TAB>, <&macro_release &kp LCMD>;
        display-name = "App Switcher";
      };

      // M6: Cmd+Space (spotlight)
      m6: m6 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD>, <&macro_tap &kp SPACE>, <&macro_release &kp LCMD>;
        display-name = "Spotlight";
      };

      // M7: Sticky Shift+Alt+Cmd, then Up
      m7: m7 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LSHIFT &kp LALT &kp LCMD>, <&macro_tap &kp UP>, <&macro_release &kp LSHIFT &kp LALT &kp LCMD>;
        display-name = "Move Window Up";
      };

      // M9: Shift+Tab (reverse tab)
      m9: m9 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LSHIFT>, <&macro_tap &kp TAB>, <&macro_release &kp LSHIFT>;
        display-name = "Reverse Tab";
      };

      // M10: Cmd+Shift+4 (screenshot)
      m10: m10 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCMD &kp LSHIFT>, <&macro_tap &kp N4>, <&macro_release &kp LCMD &kp LSHIFT>;
        display-name = "Screenshot";
      };

      // M11: Ctrl+G
      m11: m11 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp G>, <&macro_release &kp LCTRL>;
        display-name = "Ctrl+G";
      };

      // M12: Ctrl+S (save)
      m12: m12 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>;
        display-name = "Save";
      };
    };
  };

  keymap {
    compatible = "zmk,keymap";

    // Layer 0: Default (Base)
    default_layer {
      display-name = "Base";
      bindings = <
        &none    &none   &none   &none   &none   &none   &tog MOD                                                             &mo MOD  &none      &none      &none      &none      &none      &none
        &none    &kp Q   &kp W   &kp E   &kp R   &kp T   &none                                                                &none    &kp Y      &kp U      &kp I      &kp O      &kp P      &none
        &kp ESC  &kp A   &kp S   &kp D   &kp F   &kp G   &none           &none      &none      &none      &none                &none    &kp H      &kp J      &kp K      &kp L      &kp SEMI   &none
        &none    &kp Z   &kp X   &kp C   &kp V   &kp B                               &none      &none                                   &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &none
        &none    &none   &none   &none   &none                   &mo NAV  &kp LSHIFT &none      &none      &kp SPACE  &mo NUM                     &none      &none      &none      &none      &none
      >;
    };

    // Layer 1: Navigation
    nav {
      display-name = "Nav";
      bindings = <
        &none    &none     &none      &none      &none      &none       &none                                                                &mo MOD  &none        &none          &none        &none        &none        &none
        &none    &m9       &none      &none      &none      &kp LC(X)   &none                                                                &none  &none        &kp LC(N)      &kp LC(P)    &kp TAB      &kp BSPC     &none
        &none    &kp ESC   &m12       &none      &none      &m11        &none           &none      &none      &none      &none                &none  &kp LEFT     &kp DOWN       &kp UP       &kp RIGHT    &kp ENTER    &none
        &none    &kp LSHFT &sk LCTRL  &none      &none      &none                                  &none      &none                                  &kp LC(N)    &kp LC(BSLH)   &none        &sk LCTRL    &kp LSHIFT   &none
        &none    &none     &none      &none      &none                          &none   &trans     &none      &none      &kp SPACE  &mo MKR                      &none          &none        &none        &none        &none
      >;
    };

    // Layer 2: Numbers and Symbols
    num {
      display-name = "Num";
      bindings = <
        &none    &none      &none      &none       &none       &none       &none                                                                &mo MOD  &none       &none    &none      &none       &none       &none
        &none    &kp EXCL   &kp AT     &kp HASH    &kp DLLR    &kp PRCNT   &none                                                                &none  &kp CARET   &kp AMPS &kp STAR   &kp LPAR    &kp RPAR    &none
        &none    &kp N1     &kp N2     &kp N3      &kp N4      &kp N5      &none           &none      &none      &none      &none                &none  &kp N6      &kp N7   &kp N8     &kp N9      &kp N0      &none
        &none    &kp PLUS   &kp TILDE  &kp GRAVE   &kp PIPE    &kp BSLH                               &none      &none                                  &none       &none    &none      &kp LBKT    &kp RBKT    &none
        &none    &none      &none      &none       &none                           &mo MKR &trans     &none      &none      &trans     &none                       &none    &none      &none       &none       &none
      >;
    };

    // Layer 3: Macros
    mkr {
      display-name = "Mkr";
      bindings = <
        &none  &none  &none  &none  &none  &none  &none                                                           &mo MOD  &none  &none  &none  &none  &none  &none
        &none  &none  &m3    &m4    &m2    &none  &none                                                           &none  &none  &none  &none  &none  &none  &none
        &none  &none  &none  &m10   &m5    &none  &none           &none &none   &none   &none                     &none  &none  &m6    &none  &none  &none  &none
        &none  &none  &none  &m0    &m1    &m7                           &none   &none                                   &none  &none  &none  &none  &none  &none
        &none  &none  &none  &none  &none                  &none &trans &none   &none   &trans &none                           &none  &none  &none  &none  &none
      >;
    };

    // Layer 4: Mod (Bluetooth, settings, etc.)
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    extra1 {
      display-name = "Red";
      status = "reserved";
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };
};

/* vim: set ft=c nowrap: */
